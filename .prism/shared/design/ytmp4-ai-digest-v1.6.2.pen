                        },
                        {
                          "type": "frame",
                          "id": "O7XFL",
                          "name": "core-takeaway-card",
                          "width": "fill_container",
                          "fill": "#1e293b",
                          "cornerRadius": 8,
                          "stroke": {
                            "align": "inside",
                            "thickness": 1,
                            "fill": "#3b82f6"
                          },
                          "layout": "vertical",
                          "gap": 8,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "6rGgi",
                              "name": "takeawayLabel",
                              "fill": "#60a5fa",
                              "content": "Core Takeaway",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "a5qOy",
                              "name": "takeawayText",
                              "fill": "#cbd5e1",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Modern LLMs suffer from structural amnesia in residual connections — the Kimi team's fix applies attention across depth, letting each layer selectively retrieve prior outputs. Result: equal performance at 1.25x lower compute cost.",
                              "lineHeight": 1.5,
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "rSWqQ",
                          "name": "key-points-card",
                          "width": "fill_container",
                          "fill": "#1e293b",
                          "cornerRadius": 8,
                          "layout": "vertical",
                          "gap": 8,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "v3oru",
                              "name": "kpLabel",
                              "fill": "#34d399",
                              "content": "Key Points",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "Nt3Oz",
                              "name": "kp1",
                              "fill": "#cbd5e1",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "• Standard residual connections dilute early-layer information as outputs accumulate — later layers dominate the signal",
                              "lineHeight": 1.4,
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "Hln5F",
                              "name": "kp2",
                              "fill": "#cbd5e1",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "• Attention residuals apply QKV across the layer dimension — each layer queries prior layers and retrieves only relevant representations",
                              "lineHeight": 1.4,
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "D288p",
                              "name": "kp3",
                              "fill": "#cbd5e1",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "• Block attention residuals solve pipeline-parallel traffic explosion with server-rack-aligned segmentation",
                              "lineHeight": 1.4,
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "bHzLe",
                              "name": "kp4",
                              "fill": "#cbd5e1",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "• +7.5 points on GPQA Diamond; consistent gains on MMLU, math, and coding benchmarks",
                              "lineHeight": 1.4,
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "MjR9j",
                          "name": "why-it-matters-card",
                          "width": "fill_container",
                          "fill": "#1e293b",
                          "cornerRadius": 8,
                          "layout": "vertical",
                          "gap": 8,
                          "padding": 14,
                          "children": [
                            {
                              "type": "text",
                              "id": "JzX8O",
                              "name": "whyLabel",
                              "fill": "#fbbf24",
                              "content": "Why It Matters",
                              "fontFamily": "Inter",
                              "fontSize": 11,
                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "s2Lh0",
                              "name": "whyText",
                              "fill": "#cbd5e1",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "This targets the residual connection — a design assumption in every major LLM since 2015 — with a concrete, infrastructure-compatible replacement. The 1.25x compute reduction at scale translates to tens of millions per training run.",
                              "lineHeight": 1.5,
                              "fontFamily": "Inter",
                              "fontSize": 12,
                              "fontWeight": "normal"
                            }
                          ]
                        }

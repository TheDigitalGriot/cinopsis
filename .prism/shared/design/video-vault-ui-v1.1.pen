                      "type": "text",
                      "id": "q06rU",
                      "name": "tText3",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Similar words cluster together. 'King' and 'queen' are close, while 'king' and 'toaster' are far apart...",
                      "lineHeight": 1.5,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }

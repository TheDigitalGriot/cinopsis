                      "type": "text",
                      "id": "cAL2X",
                      "name": "tTime3",
                      "fill": "$accent-orange",
                      "content": "0:32",
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 11,
                      "fontWeight": "600"
                    },

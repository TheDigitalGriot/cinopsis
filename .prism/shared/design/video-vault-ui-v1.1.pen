                      "fontFamily": "JetBrains Mono",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "XgHJ1",
                  "name": "tLine2",
                  "width": "fill_container",
                  "gap": 12,

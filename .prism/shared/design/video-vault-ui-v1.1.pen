                      "type": "text",
                      "id": "elwmx",
                      "name": "tText2",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Let's start with the fundamental building block: the word embedding. Think of each word as a point in a high-dimensional space.",
                      "lineHeight": 1.5,
                      "fontFamily": "JetBrains Mono",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "rwiK1",
                  "name": "tLine3",
                  "width": "fill_container",
                  "gap": 12,

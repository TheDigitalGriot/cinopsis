# youtube-ai-digest data
# NB: use data/* (contents), not data/ (the dir) — Git won't descend into an
# excluded directory, so !data/*.json negations only fire against data/* .
data/*
!data/channels.json
!data/playlists.json
__pycache__/
*.pyc
.DS_Store
*.png
*.jpg
*.webp

# Superpowers brainstorm artifacts
.superpowers/

# Prism working directory
.prism/

# Design docs are tracked
!docs/

# Prism local artifacts (not committed)
.prism/local/

.prism/*-progress.txt
.prism/local/
